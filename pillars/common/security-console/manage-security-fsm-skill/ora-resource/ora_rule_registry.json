{
  "schema_version": "3.0",
  "skill_id": "common.security-console.manage-security-fsm-skill",
  "tasks": [
    {
      "task_code": "ASXS_MANAGE_JOB_ROLES",
      "task_name": "Manage Job Roles",
      "start_node": "MS.VALIDATE",
      "readiness": {
        "status": "ready",
        "blocking_reasons": []
      },
      "nodes": [
        {
          "id": "MS.VALIDATE",
          "node_type": "step",
          "sequence": 1,
          "action_type": "validate_input",
          "transitions": {"valid": "MS.DEFAULT", "invalid": "MS.RETURN_ISSUES"},
          "prerequisites": [],
          "on_failure": "stop",
          "applies_when": "Before any archive preview or import handoff.",
          "source": {"file": "ora_input_validation.md"}
        },
        {
          "id": "MS.DEFAULT",
          "node_type": "step",
          "sequence": 2,
          "action_type": "apply_default",
          "transitions": {"complete": "MS.DEPENDENCY", "missing": "MS.RETURN_ISSUES"},
          "prerequisites": ["MS.VALIDATE"],
          "on_failure": "stop",
          "applies_when": "Apply only fail-closed defaults.",
          "source": {"file": "ora_defaulting_rules.md"}
        },
        {
          "id": "MS.DEPENDENCY",
          "node_type": "decision",
          "sequence": 3,
          "action_type": "resolve_dependency",
          "transitions": {"ready": "MS.DESIGN_GATE", "blocked": "MS.RETURN_ISSUES"},
          "prerequisites": ["MS.DEFAULT"],
          "on_failure": "stop",
          "applies_when": "Before an import preview.",
          "source": {"file": "ora_dependency_readiness.md"}
        },
        {
          "id": "MS.DESIGN_GATE",
          "node_type": "decision",
          "sequence": 4,
          "action_type": "design_enforcement",
          "transitions": {"pass": "MS.EXECUTION_GATE", "issues": "MS.RETURN_ISSUES"},
          "prerequisites": ["MS.DEPENDENCY"],
          "on_failure": "stop",
          "applies_when": "After dependency evidence is available and before an import preview.",
          "source": {"file": "ora_design_enforcement.md"}
        },
        {
          "id": "MS.EXECUTION_GATE",
          "node_type": "decision",
          "sequence": 5,
          "action_type": "execution_gate",
          "transitions": {"ready": "MS.READY", "blocked": "MS.RETURN_ISSUES"},
          "prerequisites": ["MS.DESIGN_GATE"],
          "on_failure": "stop",
          "applies_when": "Immediately before an approved Data Loader handoff.",
          "source": {"file": "ora_error_handling.md"}
        },
        {
          "id": "MS.READY",
          "node_type": "terminal",
          "sequence": 6,
          "action_type": "terminal",
          "transitions": {},
          "prerequisites": ["MS.EXECUTION_GATE"],
          "on_failure": "continue",
          "applies_when": "All validation gates have passed.",
          "source": {"file": "ora_error_handling.md"}
        },
        {
          "id": "MS.RETURN_ISSUES",
          "node_type": "terminal",
          "sequence": 7,
          "action_type": "terminal",
          "transitions": {},
          "prerequisites": [],
          "on_failure": "continue",
          "applies_when": "A validation or approval gate is blocked.",
          "source": {"file": "ora_error_handling.md"}
        }
      ]
    }
  ],
  "flow": "fail-closed: validation -> defaulting -> dependency readiness -> design gate -> execution gate -> ready or return issues"
}
