            "title": "OCI User List Information"
        },
        "GroupList": {
            "description": "A Collection of Groups",
            "type": "object",
            "properties": {
                "totalResults": {
                    "type": "number"
                },
                "startIndex": {
                    "type": "number"
                },
                "itemsPerPage": {
                    "type": "number"
                },
                "Resources": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/Group"
                    }
                }
            },
            "title": "OCI Group List Information"
        },
        "AppRoleList": {
            "description": "A Collection of Application Role",
            "type": "object",
            "properties": {
                "totalResults": {
                    "type": "number"
                },
                "startIndex": {
                    "type": "number"
                },
                "itemsPerPage": {
                    "type": "number"
                },
                "Resources": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/AppRole"
                    }
                }
            },
            "title": "OCI Application Role List Information"
