    "securityDefinitions": {
        "access_token": {
            "in": "header",
            "name": "Authorization",
            "type": "Bearer"
        },
        "oauth": {
            "flow": "client_credentials",
            "scopes": {
                "urn:opc:idm:__myscopes__": "Get user and group info"
            },
            "tokenUrl": "https://<Host.OCIDomain.Name>/oauth2/v1/token",
            "type": "oauth2"
        }
    },
    "parameters": {
        "attributesParam": {
            "description": "A comma-delimited string that specifies the names of resource attributes that should be returned in the response.",
            "in": "query",
            "name": "attributes",
            "type": "string"
        },
        "startIndexParam": {
            "description": "An integer that indicates the 1-based index of the first query result.",
            "in": "query",
            "name": "startIndex",
            "type": "string"
        },
        "countParam": {
            "description": "An integer that indicates the desired maximum number of query results per page.",
            "in": "query",
            "name": "count",
            "type": "string"
        }
    }
