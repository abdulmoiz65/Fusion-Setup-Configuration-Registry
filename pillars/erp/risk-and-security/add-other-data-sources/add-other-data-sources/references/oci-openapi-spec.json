{
    "swagger": "2.0",
    "info": {
        "description": "This API was built based on what is used by the OCI. It contains a small subset of the API provided by OCI.",
        "title": "OCI",
        "version": 3
    },
    "host": "<Host.OCIDomain.Name>",
    "basePath": "/admin/v1",
    "schemes": [
        "https"
    ],
    "paths": {
        "/Users": {
            "get": {
                "operationId": "users",
                "parameters": [
                    {
                        "$ref": "#/parameters/attributesParam"
                    },
                    {
                        "$ref": "#/parameters/startIndexParam"
                    },
                    {
                        "$ref": "#/parameters/countParam"
                    }
                ],
                "produces": [
                    "application/json"
                ],
                "responses": {
                    "200": {
                        "description": "Typical success response",
                        "schema": {
                            "$ref": "#/definitions/UserList"
                        }
                    }
                },
                "security": [
                    {
                        "access_token": [

                        ]
                    }
                ],
                "description": "Gets information about users.",
                "summary": "Get Users Information"
            }
        },
        "/Groups": {
            "get": {
                "operationId": "groups",
                "parameters": [
                    {
                        "$ref": "#/parameters/attributesParam"
                    },
                    {
                        "$ref": "#/parameters/startIndexParam"
                    },
                    {
                        "$ref": "#/parameters/countParam"
                    }
                ],
                "produces": [
                    "application/json"
                ],
                "responses": {
                    "200": {
                        "description": "Typical success response",
                        "schema": {
                            "$ref": "#/definitions/GroupList"
                        }
                    }
                },
                "security": [
                    {
                        "access_token": [

                        ]
                    }
                ],
                "description": "Gets information about groups.",
                "summary": "Get Group List Information"
            }
        },
        "/AppRoles": {
            "get": {
                "operationId": "approles",
                "parameters": [
                    {
                        "$ref": "#/parameters/attributesParam"
                    },
                    {
                        "$ref": "#/parameters/startIndexParam"
                    },
                    {
                        "$ref": "#/parameters/countParam"
                    }
                ],
                "produces": [
                    "application/json"
                ],
                "responses": {
                    "200": {
                        "description": "Typical success response",
                        "schema": {
                            "$ref": "#/definitions/AppRoleList"
                        }
                    }
                },
                "security": [
                    {
                        "access_token": [

                        ]
                    }
                ],
                "description": "Gets information about application roles.",
                "summary": "Get Application Role List Information"
            }
        }
    },
    "definitions": {
        "Email": {
            "properties": {
                "secondary": {
                    "type": "boolean",
                    "title": "Is secondary email"
                },
                "verified": {
                    "type": "boolean",
                    "title": "Email verified"
                },
                "primary": {
                    "type": "boolean",
                    "title": "Is primary email"
                },
                "type": {
                    "type": "string",
                    "title": "Email type"
                },
                "value": {
                    "type": "string",
                    "title": "Email"
                }
            },
            "title": "User profile",
            "type": "object"
        },
        "AppRoleShort": {
            "properties": {
                "appName": {
