                "urn:ietf:params:scim:schemas:oracle:idcs:extension:user:User": {
                    "type": "object",
                    "properties": {
                        "appRoles": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/AppRoleShort"
                            }
                        }
                    }
                }
            },
            "title": "User profile",
            "type": "object"
        },
        "Member": {
            "properties": {
                "display": {
                    "type": "string",
