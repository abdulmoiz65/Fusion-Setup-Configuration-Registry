                        }
                    }
                },
                "adminRole": {
                     "type": "boolean",
                     "title": "Is administrator role"
                }
            },
            "title": "Application Role",
            "type": "object"
        },
        "User": {
            "properties": {
                "id": {
                    "type": "string"
                },
                "name": {
                    "title": "User Full Name",
                    "type": "object",
                    "properties": {
                        "givenName": {
                            "type": "string",
                            "title": "Given Name"
                        },
                        "formatted": {
                            "type": "string",
