{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fscr.oracle.com/schemas/pick-wave-release-rules/planning-validation-output.schema.json",
  "title": "Pick Wave Release Rules planning and validation output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "artifact_type",
    "task_code",
    "task_name",
    "status",
    "generated_at",
    "source_evidence",
    "validation",
    "errors"
  ],
  "properties": {
    "contract_version": {
      "const": "1.0"
    },
    "artifact_type": {
      "enum": [
        "setup_task_plan",
        "setup_data_routing",
        "validation_result"
      ]
    },
    "task_code": {
      "const": "ORA_PICK_WAVE_RELEASE_RULES"
    },
    "task_name": {
      "const": "Pick Wave Release Rules"
    },
    "status": {
      "enum": [
        "passed",
        "blocked",
        "failed"
      ]
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "description"],
        "properties": {
          "source": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 }
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "checks"],
      "properties": {
        "status": { "enum": ["passed", "blocked", "failed"] },
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "status"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "status": { "enum": ["passed", "blocked", "failed"] },
              "message": { "type": "string" }
            }
          }
        }
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "message"],
        "properties": {
          "code": { "type": "string", "minLength": 1 },
          "message": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "passed" } } },
      "then": {
        "properties": {
          "validation": {
            "properties": { "status": { "const": "passed" } }
          },
          "errors": { "maxItems": 0 }
        }
      }
    }
  ]
}
