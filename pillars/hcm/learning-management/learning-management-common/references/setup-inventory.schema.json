{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Learning setup assessment inventory (not an execution payload)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "environment",
    "generated_at",
    "release",
    "scope",
    "evidence_refs",
    "coverage",
    "items",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "environment": {
      "type": "string",
      "minLength": 1
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "release": {
      "type": [
        "string",
        "null"
      ]
    },
    "scope": {
      "type": "object"
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "coverage": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "area",
          "status",
          "note"
        ],
        "properties": {
          "area": {
            "type": "string"
          },
          "status": {
            "enum": [
              "assessed",
              "partially_assessed",
              "not_assessed",
              "excluded"
            ]
          },
          "note": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/item"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "area",
        "category",
        "code",
        "name",
        "scope",
        "requirement",
        "condition",
        "basis",
        "current",
        "expected",
        "decision",
        "fit",
        "action",
        "next_action",
        "owner",
        "approval"
      ],
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1
        },
        "area": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "code": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "requirement": {
          "enum": [
            "required_for_scope",
            "conditional",
            "optional",
            "future_scope",
            "excluded"
          ]
        },
        "condition": {
          "type": "string",
          "minLength": 1
        },
        "basis": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "current": {
          "$ref": "#/$defs/current"
        },
        "expected": {
          "type": [
            "string",
            "null"
          ]
        },
        "decision": {
          "type": [
            "string",
            "null"
          ]
        },
        "fit": {
          "enum": [
            "meets_decision",
            "review_needed",
            "gap",
            "unknown",
            "not_applicable"
          ]
        },
        "action": {
          "enum": [
            "keep",
            "propose_change",
            "input_required",
            "verify",
            "defer",
            "exclude"
          ]
        },
        "next_action": {
          "type": "string",
          "minLength": 1
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "approval": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "refs"
          ],
          "properties": {
            "status": {
              "enum": [
                "not_requested",
                "required",
                "approved",
                "completed_verified",
                "uncertain"
              ]
            },
            "refs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "current": {
                "properties": {
                  "state": {
                    "const": "not_validated"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "fit": {
                "enum": [
                  "unknown",
                  "not_applicable"
                ]
              },
              "action": {
                "enum": [
                  "verify",
                  "input_required",
                  "defer",
                  "exclude"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "fit": {
                "const": "gap"
              }
            }
          },
          "then": {
            "properties": {
              "requirement": {
                "enum": [
                  "required_for_scope",
                  "conditional"
                ]
              },
              "expected": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "propose_change"
              }
            }
          },
          "then": {
            "properties": {
              "fit": {
                "const": "gap"
              },
              "approval": {
                "properties": {
                  "status": {
                    "enum": [
                      "required",
                      "approved"
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "approval": {
                "properties": {
                  "status": {
                    "enum": [
                      "approved",
                      "completed_verified",
                      "uncertain"
                    ]
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "approval": {
                "properties": {
                  "refs": {
                    "minItems": 1
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "approval": {
                "properties": {
                  "status": {
                    "const": "completed_verified"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "current": {
                "properties": {
                  "state": {
                    "const": "observed"
                  },
                  "complete": {
                    "const": true
                  }
                }
              },
              "fit": {
                "const": "meets_decision"
              }
            }
          }
        }
      ]
    },
    "current": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "value",
        "redacted",
        "observed_at",
        "complete",
        "evidence_refs",
        "method",
        "editability"
      ],
      "properties": {
        "state": {
          "enum": [
            "observed",
            "confirmed_absent",
            "not_validated"
          ]
        },
        "value": {
          "type": [
            "string",
            "number",
            "boolean",
            "null"
          ]
        },
        "redacted": {
          "type": "boolean"
        },
        "observed_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "complete": {
          "type": "boolean"
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "editability": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "not_validated"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "null"
              },
              "observed_at": {
                "type": "null"
              },
              "complete": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "enum": [
                  "observed",
                  "confirmed_absent"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "observed_at": {
                "type": "string",
                "format": "date-time"
              },
              "evidence_refs": {
                "minItems": 1
              },
              "complete": {
                "const": true
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "confirmed_absent"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "redacted": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    }
  }
}
