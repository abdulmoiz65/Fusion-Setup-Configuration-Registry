{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oracle.example/fdos/hcm/profile-rating-model-requirements.schema.json",
  "title": "Profile Rating Model Requirements",
  "type": "object",
  "required": ["schema_version", "operation", "request_id", "source", "model", "levels", "handoffs"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "operation": {"const": "create_or_reuse"},
    "request_id": {"type": "string", "minLength": 1},
    "source": {
      "type": "object",
      "required": ["type", "name", "version"],
      "properties": {
        "type": {"enum": ["conversation", "generated_workbook", "customer_workbook", "json"]},
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "model": {
      "type": "object",
      "required": ["consumers", "business_purpose", "intended_population", "code", "name", "description", "effective_start_date", "languages", "highest_number_is_best"],
      "properties": {
        "consumers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["Profile Management", "Performance Management", "Talent Review and Succession", "Compensation", "Skills Center"]}},
        "business_purpose": {"type": "string", "minLength": 1},
        "intended_population": {"type": "string", "minLength": 1},
        "code": {"type": "string", "minLength": 1, "pattern": "^[A-Z][A-Z0-9_]*$"},
        "name": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "effective_start_date": {"type": "string", "format": "date"},
        "effective_end_date": {"type": ["string", "null"], "format": "date"},
        "languages": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 2}},
        "highest_number_is_best": {"type": "boolean"}
      },
      "additionalProperties": true
    },
    "levels": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["sequence", "code", "name", "short_description", "full_description"],
        "properties": {
          "sequence": {"type": "integer", "minimum": 1},
          "code": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1},
          "short_description": {"type": "string", "minLength": 1},
          "full_description": {"type": "string", "minLength": 1},
          "numeric_rating": {"type": ["integer", "null"]},
          "review_point": {"type": ["number", "null"]},
          "range_from": {"type": ["number", "null"]},
          "range_to": {"type": ["number", "null"]},
          "category": {"type": ["string", "null"]},
          "distribution_min": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
          "distribution_max": {"type": ["number", "null"], "minimum": 0, "maximum": 100}
        },
        "additionalProperties": true
      }
    },
    "performance": {"type": "object"},
    "talent_review": {"type": "object"},
    "compensation": {"type": "object"},
    "skills_center": {"type": "object"},
    "translations": {"type": "array", "items": {"type": "object"}},
    "handoffs": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["consumer", "intended_usage", "required_association", "downstream_owner"]}}
  },
  "additionalProperties": false
}
