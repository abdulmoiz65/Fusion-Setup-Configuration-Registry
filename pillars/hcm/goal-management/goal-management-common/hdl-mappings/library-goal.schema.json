{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "component", "context", "routes", "variants", "sources", "fields"],
  "properties": {
    "$schema": {"type": "string"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "component": {"const": "ContentItem"},
    "context": {"const": "GOAL"},
    "routes": {"const": ["hdl_generate", "hdl_dat_preflight"]},
    "variants": {"const": {"performance_library_goal": "PERFORMANCE", "development_library_goal": "DEVELOPMENT"}},
    "sources": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "minLength": 1}},
    "fields": {
      "type": "object",
      "required": ["GoalName", "TypeCode", "StatusCode", "Visible"],
      "additionalProperties": {
        "type": "object", "additionalProperties": false,
        "required": ["field", "type", "source"],
        "properties": {
          "field": {"type": "string", "minLength": 1},
          "type": {"enum": ["string", "date", "integer"]},
          "source": {"type": "string", "minLength": 1},
          "required": {"type": "boolean"},
          "requiresValueEvidence": {"type": "boolean"},
          "default": {"type": "string", "minLength": 1},
          "codes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
        }
      }
    }
  }
}
