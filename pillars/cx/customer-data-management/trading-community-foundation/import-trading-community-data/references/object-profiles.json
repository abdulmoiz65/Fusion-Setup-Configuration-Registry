{
  "schema_version": 3,
  "source": "Oracle CX Import Management object picker, downloaded templates, Oracle Import Management guidance reviewed through 2026-09-01, and nonproduction import outcomes verified through 2026-08-24",
  "import_mode_map": {
    "create": "CREATE_ONLY",
    "create-or-update": "CREATE_RECORD",
    "delete": "DELETE_RECORD"
  },
  "runtime_import_support": {
    "resource": "/crmRestApi/resources/11.13.18.05/importExportObjectMetadata",
    "finder": "objectRowFinder",
    "required_match": "exact ObjectCode with ImportSupport=Y",
    "evidence_note": "Generic objectMetadata and downloaded templates do not prove Import Management submission support."
  },
  "resolution_link_campaign": {
    "activity_sequence": [
      {
        "object_code": "DedupLink",
        "operation": "create",
        "verification_strategy": "resolution-link",
        "produces_parent_identity": "LinkNumber"
      },
      {
        "object_code": "LinkMember",
        "operation": "create",
        "parent_identity_source": "DedupLink.LinkNumber",
        "verification_strategy": "resolution-link-member"
      }
    ],
    "member_semantics": {
      "required_master_count_for_new_link": 1,
      "csv_master_values": ["Y", "N"],
      "rest_master_values": [true, false],
      "active_member_status": "A"
    },
    "approval_rule": "Each activity requires its own immutable preview and approval after its parent identities are resolved."
  },
  "documentation_sources": {
    "AdditionalIdentifier": "https://docs.oracle.com/en/cloud/saas/sales/faiem/import-your-additional-identifier-data.html",
    "Assets": "https://docs.oracle.com/en/cloud/saas/sales/faiem/import-your-asset-data.html",
    "AssetContact": "https://docs.oracle.com/en/cloud/saas/sales/faiem/import-your-asset-contact-data.html",
    "AssetResource": "https://docs.oracle.com/en/cloud/saas/sales/faiem/import-your-asset-resource-data.html",
    "Hierarchy": "https://docs.oracle.com/en/cloud/saas/sales/oacdm/import-your-hierarchy-data.html",
    "HierarchyNode": "https://docs.oracle.com/en/cloud/saas/sales/faiem/import-your-hierarchy-member-data.html",
    "import_modes": "https://docs.oracle.com/en/cloud/saas/customer-data-management/faudm/import-data.html",
    "high_volume": "https://docs.oracle.com/en/cloud/saas/sales/oasal/options-for-importing-data-into-your-application.html"
  },
  "request_completion_contract": {
    "terminal_statuses": ["completed_and_verified", "failed_no_record_created", "deferred", "not_submitted", "unknown_requires_reconciliation"],
    "mutation_types": ["created", "updated", "deleted", "inactivated", "none"],
    "required_process_evidence": ["import_activity_id", "ucm_content_id", "process_counts"],
    "required_target_evidence": ["exact_match_count", "target_record_ids", "parent_identity_when_applicable", "state_or_active_dates_when_applicable", "source_reference_when_supplied"],
    "completion_rule": "Every requested record instance must have one ledger outcome. completed_and_verified requires process evidence plus exact target evidence; loaded count alone is not verification.",
    "object_completion_rule": "An object is complete only when every requested instance for that object is completed_and_verified.",
    "semantic_rules": [
      "Relationship, AccountContact, and LinkedParty are distinct and cannot satisfy one another.",
      "AssetResource (Asset Team Member) and SalesTeamMember are distinct and cannot satisfy one another.",
      "An Account-to-Contact association does not satisfy an Account-to-Account link request.",
      "Account and Organization are distinct; Contact and Person are distinct.",
      "ZCA_CUSTOMER and SALES_ACCOUNT do not establish financial CUSTOMER usage.",
      "Created, updated, deleted, and inactivated mutations must be counted separately."
    ]
  },
