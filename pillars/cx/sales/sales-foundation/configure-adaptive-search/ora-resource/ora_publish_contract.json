          "entities": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "publishType": {"const": "selective"}
        }
      },
      {
        "title": "Full publish for selected entities",
        "type": "object",
        "required": ["entities"],
        "additionalProperties": false,
        "properties": {
          "entities": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    ]
  },
