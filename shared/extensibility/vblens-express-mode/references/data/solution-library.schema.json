{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "vblens-express-mode-solution-library-v1",
  "title": "VBLens Express Mode confirmed solution library",
  "type": "object",
  "required": ["schemaVersion", "solutions"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "solutions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "useCase",
          "page",
          "operation",
          "release",
          "paths",
          "assumptions",
          "source",
          "testConfirmation"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "title": { "type": "string", "minLength": 1 },
          "useCase": { "type": "string", "minLength": 1 },
          "page": { "type": "string", "minLength": 1 },
          "operation": { "type": "string", "minLength": 1 },
          "release": { "type": "string", "minLength": 1 },
          "paths": { "type": "array", "items": { "type": "string" } },
          "assumptions": { "type": "array", "items": { "type": "string" } },
          "source": {
            "type": "object",
            "required": ["type", "identifier", "confidence"]
          },
          "testConfirmation": {
            "type": "object",
            "required": ["status", "scenarios"],
            "properties": {
              "status": { "const": "passed" },
              "scenarios": { "type": "array", "minItems": 1, "items": { "type": "string" } }
            }
          }
        }
      }
    }
  }
}
