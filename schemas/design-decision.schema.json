{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fdos.oracle.example/schemas/design-decision.schema.json",
  "title": "Design Decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "decision_id",
    "title",
    "status",
    "context",
    "decision",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "decision_id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": ["proposed", "accepted", "rejected", "superseded"]
    },
    "context": {
      "type": "string"
    },
    "decision": {
      "type": "string"
    },
    "alternatives": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "consequences": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "related_artifact_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
