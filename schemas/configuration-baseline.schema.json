{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fdos.oracle.example/schemas/configuration-baseline.schema.json",
  "title": "Configuration Baseline",
  "type": "object",
  "additionalProperties": false,
  "required": ["source_instance", "captured_at", "scope", "artifacts"],
  "properties": {
    "baseline_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "project_id": {
      "type": "string"
    },
    "source_instance": {
      "type": "string"
    },
    "captured_at": {
      "type": "string",
      "format": "date-time"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pillar": {
          "type": "string"
        },
        "offering": {
          "type": "string"
        },
        "functional_area": {
          "type": "string"
        },
        "task": {
          "type": "string"
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "type", "location"],
        "properties": {
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": ["csv", "json", "xml", "xlsx", "other"]
          },
          "location": {
            "type": "string"
          },
          "checksum": {
            "type": "string"
          }
        }
      }
    }
  }
}
