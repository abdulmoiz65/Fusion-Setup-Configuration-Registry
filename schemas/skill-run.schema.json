{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fdos.oracle.example/schemas/skill-run.schema.json",
  "title": "Skill Run",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "skill_id",
    "started_at",
    "status",
    "inputs",
    "outputs",
    "artifact_refs"
  ],
  "properties": {
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "skill_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(\\.[a-z0-9-]+)+$"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": ["started", "completed", "failed", "superseded"]
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "artifact_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "token_usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "estimation_method",
        "estimated_input_tokens",
        "estimated_output_tokens",
        "estimated_total_tokens",
        "artifacts_written",
        "files_read"
      ],
      "properties": {
        "estimation_method": {
          "type": "string",
          "minLength": 1
        },
        "estimated_input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "estimated_output_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "estimated_total_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "artifacts_written": {
          "type": "integer",
          "minimum": 0
        },
        "files_read": {
          "type": "integer",
          "minimum": 0
        },
        "log_ref": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "notes": {
      "type": "string"
    }
  }
}
