{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fdos.oracle.example/schemas/validation-result.schema.json",
  "title": "Validation Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "findings"],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["passed", "warning", "failed"]
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["severity", "message"],
        "properties": {
          "severity": {
            "type": "string",
            "enum": ["info", "warning", "error"]
          },
          "message": {
            "type": "string"
          },
          "artifact": {
            "type": "string"
          },
          "recommended_action": {
            "type": "string"
          }
        }
      }
    }
  }
}
