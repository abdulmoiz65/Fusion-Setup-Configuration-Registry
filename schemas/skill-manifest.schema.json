{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fdos.oracle.example/schemas/skill-manifest.schema.json",
  "title": "FSCR Skill Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "skill_id",
    "name",
    "layer",
    "type",
    "execution_mode",
    "owner_team",
    "inputs",
    "outputs"
  ],
  "allOf": [
    {
      "not": {
        "required": ["businessObject", "businessObjects"]
      }
    },
    {
      "$comment": "Pillar-only generated metadata is emitted only by core.fusion-dev.pillar-skill-gen for pillar-layer skill manifests.",
      "if": {
        "properties": {
          "layer": {
            "const": "pillar"
          }
        },
        "required": ["layer"]
      },
      "else": {
        "not": {
          "anyOf": [
            {"required": ["offering"]},
            {"required": ["functional_area"]},
            {"required": ["functional_area_code"]},
            {"required": ["task_code"]},
            {"required": ["task_name"]},
            {"required": ["parent_skill_id"]},
            {"required": ["available_flag"]},
            {"required": ["export_import_supported_flag"]},
            {"required": ["csv_export_import_supported_flag"]},
            {"required": ["dataloader_import_mode"]},
            {"required": ["businessObject"]},
            {"required": ["businessObjects"]},
            {"required": ["source_catalog"]}
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "layer": {
            "enum": ["shared", "pillar", "router"]
          }
        },
        "required": ["layer"]
      },
      "then": {
        "required": ["token_usage_tracking"],
        "properties": {
          "token_usage_tracking": {
            "properties": {
              "enabled": {
                "const": true
              }
            }
          }
        }
      }
    }
  ],
  "properties": {
    "skill_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(\\.[a-z0-9-]+)+$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "layer": {
      "type": "string",
      "enum": ["router", "core", "shared", "pillar"]
    },
    "pillar": {
      "type": "string",
      "enum": ["ERP", "HCM", "SCM", "CX", "Common", "Core", "Router"]
    },
    "offering": {
      "type": "string",
      "description": "Pillar-only catalog metadata; generated by core.fusion-dev.pillar-skill-gen."
    },
    "functional_area": {
      "type": "string",
      "description": "Pillar-only catalog metadata; generated by core.fusion-dev.pillar-skill-gen."
    },
    "functional_area_code": {
      "type": "string",
      "description": "Pillar-only catalog metadata; generated by core.fusion-dev.pillar-skill-gen."
    },
    "task_code": {
      "type": "string",
      "description": "Pillar-only catalog metadata; generated by core.fusion-dev.pillar-skill-gen."
    },
    "task_name": {
      "type": "string",
      "description": "Pillar-only catalog metadata; generated by core.fusion-dev.pillar-skill-gen."
    },
    "parent_skill_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(\\.[a-z0-9-]+)+$",
      "description": "Pillar-only catalog metadata; generated by core.fusion-dev.pillar-skill-gen."
    },
    "available_flag": {
      "type": "string",
      "description": "Pillar-only catalog metadata; generated by core.fusion-dev.pillar-skill-gen."
    },
    "export_import_supported_flag": {
      "type": "string",
      "description": "Pillar-only catalog metadata; generated by core.fusion-dev.pillar-skill-gen."
    },
    "csv_export_import_supported_flag": {
      "type": "string",
      "description": "Pillar-only catalog metadata; generated by core.fusion-dev.pillar-skill-gen."
    },
    "dataloader_import_mode": {
      "type": "string",
      "enum": ["FSM", "REST", "REST-BOSS", "HDL", "FBDI", "CXIMPORT", "SPREADSHEET", "ESS"],
      "description": "Pillar-only generated import-routing metadata; defaults to FSM when CSV import/export is catalog-supported and otherwise requires an explicit pillar-developer selection."
    },
    "businessObject": {
      "type": "string",
      "description": "Pillar-only generated Data Loader business-object metadata. Required for a pillar-developer-selected REST import mode and otherwise may be blank."
    },
    "businessObjects": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Pillar-only generated ordered Data Loader business-object metadata used when a task has two or more REST business objects."
    },
    "source_catalog": {
      "type": "string",
      "description": "Pillar-only catalog metadata; generated by core.fusion-dev.pillar-skill-gen."
    },
    "required_setup_tasks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "type": {
      "type": "string",
      "enum": ["orchestration", "advisory", "assessment", "planning", "export", "validation", "import", "verification"]
    },
    "execution_mode": {
      "type": "string",
      "enum": ["advisory", "assisted", "automated", "hybrid"]
    },
    "owner_team": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "depends_on": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "uses_core": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "token_usage_tracking": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "granularity",
        "artifact_type",
        "default_location",
        "estimation_method",
        "required_fields"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "granularity": {
          "type": "string",
          "enum": ["per_skill_run", "per_artifact", "per_skill_run_and_artifact"]
        },
        "artifact_type": {
          "type": "string",
          "enum": ["token_usage_record"]
        },
        "default_location": {
          "type": "string"
        },
        "estimation_method": {
          "type": "string",
          "minLength": 1
        },
        "required_fields": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "activity_start_time",
              "skill_id",
              "task",
              "trigger",
              "artifacts_written",
              "files_read",
              "estimated_input_tokens",
              "estimated_output_tokens",
              "estimated_total_tokens",
              "estimation_method",
              "notes"
            ]
          }
        }
      }
    },
    "persists_project_state": {
      "type": "boolean"
    },
    "state_updates": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "objective",
          "requirements",
          "scope",
          "skill_path",
          "runbook_control",
          "setup_task_sequence",
          "design_decisions",
          "configuration_blueprints",
          "exports",
          "baselines",
          "validation_results",
          "reports",
          "token_usage_records"
        ]
      }
    },
    "workspace_outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifact_type", "default_location", "versioning_policy"],
        "properties": {
          "artifact_type": {
            "type": "string",
            "enum": [
              "objective",
              "requirement",
              "scope",
              "setup_task_sequence",
              "design_decision",
              "configuration_blueprint",
              "configuration_export",
              "configuration_baseline",
              "validation_result",
              "report",
              "skill_run",
              "token_usage_record",
              "other"
            ]
          },
          "default_location": {
            "type": "string"
          },
          "versioning_policy": {
            "type": "string",
            "enum": ["major-new-version-minor-confirm-update", "append-only", "replace-after-confirmation"]
          }
        }
      }
    },
    "oracle_supplied_guidance_files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["purpose", "location"],
        "properties": {
          "purpose": {
            "type": "string",
            "minLength": 1
          },
          "location": {
            "type": "string",
            "pattern": "(^|/)ora[-_][^/]*\\.md$"
          }
        }
      }
    },
    "oracle_supplied_guidance_status": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        }
      ]
    },
    "applicability": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "industries": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "countries": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "fusion_releases": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "side_effects": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "required_privileges": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
